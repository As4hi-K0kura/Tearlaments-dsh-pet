{
  "name": "dsh-pet-status",
  "version": "1.0.0",
  "description": "把 DSH 的会话事件聚合成桌宠用的「工作状态档位」，并按 dsh-pet 契约对外提供本地 HTTP 接口（thinking / working / waiting / result / success / error）。",
  "icon": "assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "work-status",
    "cordis"
  ],
  "author": "K0kura-As4hi",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "assets",
    "locale",
    "test.plugin.mjs",
    "install.bat",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.plugin.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.1": "incompatible",
        "0.2.0-rc.2": "incompatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
